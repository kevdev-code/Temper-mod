{
  "schemaVersion": 1,
  "id": "temper",
  "version": "${version}",
  "name": "Temper",
  "description": "Replaces vanilla tool progression with a four-part crafting system: head, handle, binding and reinforcement, each made from a different material. Works on Fabric and NeoForge.",
  "authors": [
    "kevdev-code"
  ],
  "contact": {
    "issues": "https://github.com/kevdev-code/Temper-mod/issues",
    "sources": "https://github.com/kevdev-code/Temper-mod"
  },
  "license": "MIT",
  "icon": "assets/temper/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.kevdev_code.temper.fabric.TemperFabric"
    ],
    "client": [
      "io.github.kevdev_code.temper.fabric.client.TemperFabricClient"
    ]
  },
  "mixins": [
    "temper.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "architectury": ">=20.0.12",
    "fabric-api": "*"
  }
}
